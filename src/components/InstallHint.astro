---
// Copy follows the page's DECLARED lang, threaded down from BaseLayout via
// SiteFooter — not a /en/ path check. /projects/ is lang="en" as well, so a
// path-prefix test would get it wrong.
//
// The saved scope is the site, not the handbook, so the strings name 網站 /
// "site". design-kits is the one part still needing a connection; the
// /offline/ page carries that detail rather than crowding it in here.
interface Props {
  lang?: string;
}
const { lang = "zh-Hant-TW" } = Astro.props;
const isEnglish = lang.toLowerCase().startsWith("en");

const copy = isEnglish
  ? {
      button: "Save this site offline",
      ios: "iOS: Share menu in Safari, then Add to Home Screen, to keep this site offline",
    }
  : {
      button: "安裝離線版網站",
      ios: "iOS：用 Safari 的分享選單「加入主畫面」，整個網站即可離線使用",
    };
---
<div class="install-hint" data-install-hint hidden>
  <button class="btn btn-secondary btn-sm" type="button" data-install-btn hidden>
    {copy.button}
  </button>
  <span class="install-hint-ios" data-ios-hint hidden>
    {copy.ios}
  </span>
</div>

<script>
  const root = document.querySelector("[data-install-hint]") as HTMLElement | null;
  const btn = document.querySelector("[data-install-btn]") as HTMLButtonElement | null;
  const ios = document.querySelector("[data-ios-hint]") as HTMLElement | null;

  interface BeforeInstallPromptEvent extends Event {
    prompt: () => Promise<void>;
  }

  // Already installed → nothing to hint.
  const standalone =
    window.matchMedia("(display-mode: standalone)").matches ||
    (navigator as Navigator & { standalone?: boolean }).standalone === true;

  let deferred: BeforeInstallPromptEvent | null = null;

  if (!standalone && root) {
    // iOS Safari never fires beforeinstallprompt — show manual instructions.
    if (/iphone|ipad|ipod/i.test(navigator.userAgent) && ios) {
      root.hidden = false;
      ios.hidden = false;
    }
    // Android/desktop Chromium path: capture the prompt, offer a button.
    window.addEventListener("beforeinstallprompt", (e) => {
      e.preventDefault();
      deferred = e as BeforeInstallPromptEvent;
      if (ios) ios.hidden = true;
      if (btn) btn.hidden = false;
      root.hidden = false;
    });
    btn?.addEventListener("click", async () => {
      if (!deferred) return;
      await deferred.prompt();
      deferred = null;
      if (btn) btn.hidden = true;
    });
    window.addEventListener("appinstalled", () => {
      root.hidden = true;
    });
  }
</script>

<style>
  .install-hint {
    display: inline-flex;
    align-items: center;
    gap: var(--sp-3);
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    color: var(--ink-2);
  }
  .install-hint[hidden] { display: none; }
  /* Same hazard one level down: .btn { display: inline-flex } in global.css
     overrides the UA's [hidden] { display: none }, so the button's own hidden
     attribute does not hide it. Without this, iOS — where beforeinstallprompt
     never fires — shows a dead install button next to the share-sheet
     instructions, and Chromium leaves it on screen after a successful prompt. */
  .install-hint [hidden] { display: none; }
</style>
