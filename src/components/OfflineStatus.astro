---
// Reports SITE-level offline readiness, not handbook-level. Probes one handbook
// article AND one portal route, because as of the full-site-offline feature the
// saved scope is the whole site — a handbook-only probe would report "saved"
// while the portal was still missing.
//
// design-kits is deliberately out of the precache, so it is named as the one
// part still needing a connection. Copy follows the page's declared lang,
// threaded down from BaseLayout via SiteFooter (/projects/ is lang="en" too).
interface Props {
  lang?: string;
}
const { lang = "zh-Hant-TW" } = Astro.props;
const isEnglish = lang.toLowerCase().startsWith("en");

const copy = isEnglish
  ? {
      checking: "Checking offline cache...",
      offlineReady: "OFFLINE — site saved, works offline. Design kits need a connection.",
      offlineIncomplete: "OFFLINE — site not fully downloaded yet",
      unsupported: "This browser does not support offline caching",
      ready: "✓ Site saved, works offline. Design kits need a connection.",
      downloading: "↓ Saving the site...",
    }
  : {
      checking: "檢查離線快取…",
      offlineReady: "OFFLINE — 網站已存，離線可用；設計元件庫需連線",
      offlineIncomplete: "OFFLINE — 網站尚未下載完成",
      unsupported: "此瀏覽器不支援離線快取",
      ready: "✓ 網站已存離線可用；設計元件庫需連線",
      downloading: "↓ 網站下載中…",
    };
---
<div
  class="offline-status"
  data-offline-status
  data-copy-offline-ready={copy.offlineReady}
  data-copy-offline-incomplete={copy.offlineIncomplete}
  data-copy-unsupported={copy.unsupported}
  data-copy-ready={copy.ready}
  data-copy-downloading={copy.downloading}
>
  <span
    class="offline-status-dot"
    data-dot
    data-state="checking"
    aria-hidden="true"></span>
  <span class="offline-status-msg" data-msg aria-live="polite">{copy.checking}</span>
</div>

<script>
  const root = document.querySelector("[data-offline-status]");
  const dot = root?.querySelector("[data-dot]") as HTMLElement | null;
  const msg = root?.querySelector("[data-msg]") as HTMLElement | null;
  // Astro cannot pass the frontmatter object into a processed script, so the
  // strings ride on the element as data-* attributes.
  const COPY = root instanceof HTMLElement ? { ...root.dataset } : {};
  const BASE_URL = import.meta.env.BASE_URL;
  // Site-level readiness needs BOTH a handbook article and a portal route: the
  // handbook alone was the old, narrower claim.
  const PROBE_URLS = [`${BASE_URL}handbook/prepare/go-bag/`, BASE_URL];

  function setState(state: string, key: string) {
    if (!dot || !msg) return;
    dot.dataset.state = state;
    msg.textContent = COPY[key] ?? "";
  }

  async function siteCached(): Promise<boolean> {
    if (!("caches" in window)) return false;
    for (const url of PROBE_URLS) {
      if (!(await caches.match(url, { ignoreSearch: true }))) return false;
    }
    return true;
  }

  async function refresh() {
    if (!navigator.onLine) {
      setState("offline", (await siteCached()) ? "copyOfflineReady" : "copyOfflineIncomplete");
      return;
    }
    if (!("serviceWorker" in navigator)) {
      setState("unsupported", "copyUnsupported");
      return;
    }
    if (await siteCached()) {
      setState("ok", "copyReady");
      return;
    }
    // U+2193 DOWNWARDS ARROW (text presentation) — not the emoji-capable
    // U+2B07 variant; the design system bans emoji in UI copy.
    setState("downloading", "copyDownloading");
    await navigator.serviceWorker.ready;
    let tries = 0;
    const timer = window.setInterval(async () => {
      tries += 1;
      if (await siteCached()) {
        window.clearInterval(timer);
        setState("ok", "copyReady");
      } else if (tries >= 30) {
        window.clearInterval(timer); // give up quietly after ~60s
      }
    }, 2000);
  }

  window.addEventListener("offline", () => void refresh());
  window.addEventListener("online", () => void refresh());
  void refresh();
</script>

<style>
  .offline-status {
    display: inline-flex;
    align-items: center;
    gap: var(--sp-2);
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    font-weight: 600;
    letter-spacing: var(--tracking-label);
    color: var(--ink-2);
  }
  .offline-status-dot {
    width: 10px;
    height: 10px;
    flex: none;
    background: var(--ink-3);
  }
  .offline-status-dot[data-state="ok"] { background: var(--status-online); }
  .offline-status-dot[data-state="downloading"] {
    background: var(--status-degraded);
    animation: drt-blink 1.2s steps(1) infinite;
  }
  .offline-status-dot[data-state="offline"] { background: var(--status-offline); }
  @media (prefers-reduced-motion: reduce) {
    .offline-status-dot { animation: none; }
  }
</style>
