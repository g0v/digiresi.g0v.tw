---
// Footer chrome: mark logo, mono-caps attribution, community links, and the
// offline/install affordance. The affordance lives here — not on /handbook/ —
// so every page offers it; both components resolve a single instance with
// document.querySelector, so there must be exactly one mount per page.
import { withBase } from "../lib/base";
import OfflineStatus from "./OfflineStatus.astro";
import InstallHint from "./InstallHint.astro";

interface Props {
  lang?: string;
}
const { lang = "zh-Hant-TW" } = Astro.props;
---
<footer class="site-footer">
  <div class="container offline-row">
    <OfflineStatus lang={lang} />
    <InstallHint lang={lang} />
  </div>
  <div class="container inner">
    <img class="only-dark" src={withBase("/brand/mark-dark.png")} alt="DigiResiThon mark" height="40" />
    <img class="only-light" src={withBase("/brand/mark.png")} alt="DigiResiThon mark" height="40" />
    <div class="lines">
      A G0V COMMUNITY PROJECT · 內容 CC BY 4.0 ·
      <a href="https://g0v.hackmd.io/s/COC">CODE OF CONDUCT</a> APPLIES<br />
      NOBODY OWNS THIS. THAT MEANS YOU DO.<br />
      LOGO &copy; YELLOWONE &middot; CC BY-SA 4.0
    </div>
    <div class="links">
      <a href="https://g0v.hackmd.io/fKrjZ3BlRfWmQ471wcSdBg">SLACK #DIGIRESITHON</a>
      <a href="https://g0v.hackmd.io/mGQcbKRDShmvyeGV74w_0w">大全</a>
      <a href="https://github.com/g0v/digiresi.g0v.tw">GIT</a>
      <a href={withBase("/about/")}>關於</a>
      <a href={withBase("/en/")}>EN</a>
    </div>
  </div>
</footer>
<style>
  .site-footer {
    border-top: var(--border);
    margin-top: auto;
  }
  .offline-row {
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    gap: var(--sp-4);
    padding-top: 24px;
  }
  .inner {
    display: flex;
    align-items: center;
    gap: var(--sp-5);
    flex-wrap: wrap;
    padding-block: 28px;
  }
  /* No `display` here: flex items are already blockified, and a display value
     on this (more specific) selector would override `.only-light { display: none }`
     and show both theme variants of the mark at once. */
  .inner img {
    width: auto;
  }
  .lines {
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    color: var(--ink-3);
    letter-spacing: var(--tracking-label);
    line-height: 2;
  }
  .links {
    margin-left: auto;
    display: flex;
    gap: var(--sp-4);
    flex-wrap: wrap;
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    letter-spacing: var(--tracking-label);
  }
  .only-light { display: none; }
  :global(html[data-theme="light"]) .only-light { display: block; }
  :global(html[data-theme="light"]) .only-dark { display: none; }
</style>
