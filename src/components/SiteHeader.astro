---
import ThemeToggle from "./ThemeToggle.astro";
import RegisterDialog from "./RegisterDialog.astro";
import StatusDot from "./StatusDot.astro";
import { withBase } from "../lib/base";

const nav = [
  { href: withBase("/"), label: "首頁 HOME" },
  { href: withBase("/schedule/"), label: "時程 SCHEDULE" },
  { href: withBase("/handbook/"), label: "手冊 HANDBOOK" },
  { href: withBase("/projects/"), label: "PROJECTS" },
  { href: withBase("/design-kits/"), label: "DESIGN" },
];
// The chip reports the visitor's live connection, so it agrees with the footer's
// OfflineStatus instead of contradicting it. Labels are bilingual and NOT keyed
// on lang: BaseLayout renders <SiteHeader /> with no props (only SiteFooter gets
// lang), and every other header string is already bilingual-or-zh — 首頁 HOME,
// and a bare 報名 on the lang="en" pages. Threading lang through the header to
// translate two words would be a much larger change than this one.
// Server-rendered state is `online`: navigator.onLine is client-only, and a
// visitor who fetched this page over the network is online, so the common case
// never flips. The offline case is corrected before first paint by the blocking
// inline script below, following the theme-init pattern in BaseLayout.
const net = { online: "連線中 ONLINE", offline: "離線 OFFLINE" };
const pathname = Astro.url.pathname;
const home = withBase("/");
const isActive = (href: string) =>
  href === home ? pathname === home : pathname.startsWith(href.replace(/\/$/, ""));
---
<header class="site-header">
  <div class="container inner">
    <a class="brand" href={withBase("/")} aria-label="DigiResiThon 首頁">
      <img class="only-dark" src={withBase("/brand/lockup-dark.png")} alt="DigiResiThon" height="48" />
      <img class="only-light" src={withBase("/brand/lockup.png")} alt="DigiResiThon" height="48" />
    </a>
    <nav aria-label="主選單">
      {nav.map((n) => (
        <a
          href={n.href}
          class:list={["nav-link", { "nav-active": isActive(n.href) }]}
          aria-current={isActive(n.href) ? "page" : undefined}
        >{n.label}</a>
      ))}
    </nav>
    <StatusDot
      status="online"
      label={net.online}
      data-net-status
      data-copy-online={net.online}
      data-copy-offline={net.offline}
    />
    <ThemeToggle />
    <button class="btn btn-primary btn-sm" type="button" data-open-register>報名</button>
  </div>
</header>
<script is:inline>
  // Blocking, like the theme init, and placed after the header so the element
  // exists during parse: a visitor opening the site from the precache while
  // disconnected must never see a frame of ONLINE. Same detection as the
  // footer's OfflineStatus — navigator.onLine plus the online/offline events —
  // so the two can never disagree about the state. The footer carries the
  // sentence; this stays a chip. Copy rides on data-* attributes because an
  // is:inline script cannot see component frontmatter.
  (function () {
    var chip = document.querySelector("[data-net-status]");
    if (!chip) return;
    var label = chip.querySelector("[data-sd-label]");
    function apply() {
      var online = navigator.onLine !== false;
      chip.setAttribute("data-state", online ? "online" : "offline");
      if (label) {
        label.textContent = online ? chip.dataset.copyOnline : chip.dataset.copyOffline;
      }
    }
    apply();
    window.addEventListener("online", apply);
    window.addEventListener("offline", apply);
  })();
</script>
<RegisterDialog />
<style>
  .site-header {
    position: sticky;
    top: 0;
    z-index: 40;
    background: var(--bg);
    border-bottom: var(--border);
  }
  .inner {
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    gap: var(--sp-2) var(--sp-5);
    min-height: 64px;
    padding-block: var(--sp-2);
  }
  .brand {
    display: flex;
    align-items: center;
    gap: 10px;
    background: none;
  }
  .brand:hover { background: none; }
  /* No `display` here: flex items are already blockified, and a display value
     on this (more specific) selector would override `.only-light { display: none }`
     and show both theme variants of the lockup at once. */
  .brand img {
    width: auto;
  }
  nav {
    display: flex;
    gap: 4px;
    margin-left: auto;
  }
  .nav-link {
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    font-weight: 600;
    letter-spacing: var(--tracking-label);
    text-transform: uppercase;
    color: var(--ink);
    text-decoration: none;
    padding: 8px 12px;
  }
  .nav-link:hover,
  .nav-active {
    background: var(--ink);
    color: var(--ink-on-ink);
  }
  /* Theme swap: default (dark) shows the *-dark assets + sun icon. */
  .only-light { display: none; }
  :global(html[data-theme="light"]) .only-light { display: flex; }
  :global(html[data-theme="light"]) .only-dark { display: none; }
  :global(html[data-theme="light"]) img.only-light { display: block; }
  :global(html[data-theme="light"]) img.only-dark { display: none; }
  @media (max-width: 760px) {
    .nav-link { padding: 8px 8px; }
  }
</style>
