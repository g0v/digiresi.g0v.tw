---
import BaseLayout from "../layouts/BaseLayout.astro";
import { seoProps } from "../lib/seo/pages";
import TerminalBlock from "../components/TerminalBlock.astro";
import { withBase } from "../lib/base";
---
<BaseLayout {...seoProps("/offline/")}>
  <div class="offline-page">
    <h1 class="pixel-h-tc pixel-h-tc--2 offline-title">目前離線</h1>
    <TerminalBlock
      title="digiresithon@tw:~"
      lines={[
        { prompt: "$", text: "curl https://digiresi.g0v.tw" },
        { text: "connection failed — OFFLINE", tone: "red" },
        { text: "目前離線。這一頁是設計元件庫，需要連線才看得到。", tone: "dim" },
        { text: "網站其餘部分都已存在裝置上：首頁、關於、時程、專案、EN、手冊全文。", tone: "green" },
      ]}
      cursor={true}
    />
    <div class="offline-links">
      <a class="btn btn-primary btn-lg" href={withBase("/handbook/")}>開啟手冊</a>
      <a class="btn btn-secondary btn-lg" href={withBase("/")}>回首頁</a>
    </div>
    <p class="offline-note">回到線上之後，重新整理即可載入原本要看的頁面。</p>
  </div>
</BaseLayout>

<style>
  .offline-page {
    max-width: 640px;
    margin: 0 auto;
    padding: 64px var(--gutter);
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: var(--sp-5);
  }
  .offline-title {
    margin: 0;
    color: var(--ink);
  }
  .offline-links {
    display: flex;
    flex-wrap: wrap;
    gap: var(--sp-3);
  }
  .offline-note {
    font-family: var(--font-mono);
    font-size: var(--text-sm);
    color: var(--ink-3);
    margin: 0;
  }
</style>
