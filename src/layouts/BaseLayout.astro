---
import "../styles/global.css";
import "@fontsource/press-start-2p";
import "@fontsource/ibm-plex-mono/400.css";
import "@fontsource/ibm-plex-mono/600.css";
import "@fontsource/ibm-plex-mono/700.css";
import "@fontsource/noto-sans-tc/400.css";
import "@fontsource/noto-sans-tc/700.css";
import SiteHeader from "../components/SiteHeader.astro";
import SiteFooter from "../components/SiteFooter.astro";
import SeoHead, { type Alternate } from "../components/SeoHead.astro";
import { withBase } from "../lib/base";
import { langOf } from "../lib/seo";

interface Props {
  title: string;
  description: string;
  /** <html lang>; "en" pages get English og:locale and site name. */
  lang?: string;
  path?: string;
  ogImage?: string;
  ogImageAlt?: string;
  ogType?: "website" | "article";
  alternates?: Alternate[];
  noindex?: boolean;
  /** false omits the canonical link and og:url (404 page). */
  canonical?: boolean;
  jsonLd?: Record<string, unknown> | Record<string, unknown>[];
  section?: string;
  modified?: string;
}
const { title, description, lang = "zh-Hant-TW", ogType, ...seo } = Astro.props;
---
<html lang={lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <SeoHead title={title} description={description} lang={langOf(lang)} type={ogType} {...seo} />
    <meta name="theme-color" content="#0c0c0b" />
    <link rel="icon" href={withBase("/icons/icon-64.png")} />
    <script is:inline>
      // Blocking theme init — must run before first paint.
      // Dark ("blackout") is the default (no attribute). Light ONLY when the
      // visitor chose it via the nav toggle. No prefers-color-scheme switch.
      (function () {
        try {
          if (localStorage.getItem("digiresi:theme") === "light") {
            document.documentElement.setAttribute("data-theme", "light");
          }
        } catch (e) {
          /* storage disabled: stay dark */
        }
      })();
    </script>
    <link rel="manifest" href={withBase("/manifest.webmanifest")} />
    <script>
      // Register the offline service worker. Production only — `astro dev`
      // does not generate /sw.js (registering there would just log an error).
      // Processed scripts are deferred modules, so registering immediately is
      // safe (no need to wait for window load).
      import { withBase } from "../lib/base";
      if (import.meta.env.PROD && "serviceWorker" in navigator) {
        void navigator.serviceWorker.register(withBase("/sw.js"), {
          scope: withBase("/"),
        });
      }
    </script>
  </head>
  <body>
    <a class="skip-link" href="#main">跳到主要內容</a>
    <SiteHeader />
    <main id="main">
      <slot />
    </main>
    <SiteFooter lang={lang} />
  </body>
</html>
